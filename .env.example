# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===== QUIETINK PLACEHOLDERS FOR PRODUCTION SERVICES =====
# Database Connection URL (e.g. PostgreSQL, Neon, Supabase, Cloud SQL)
DATABASE_URL="postgresql://user:password@localhost:5432/quietink_db"

# Authentication Secret (Used for signing session cookies / JWTs)
AUTH_SECRET="your-super-secret-auth-key-32-characters-minimum"

# Cloud File Storage Endpoint (e.g. AWS S3, Google Cloud Storage, Cloudflare R2)
STORAGE_URL="https://storage.googleapis.com/your-quietink-bucket"

